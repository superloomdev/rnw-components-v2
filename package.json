{
  "name": "@superloomdev/rnw-components",
  "description": "Generic React Native Web component library for Superloom. Components own anatomy and behavior; every value, shape choice and glyph comes from the theme.",
  "version": "1.0.0",
  "author": {
    "name": "sj00"
  },
  "contributors": [],
  "private": true,
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./components.js",
    "./all": "./all.js",
    "./data/roster.json": "./data/roster.json",
    "./package.json": "./package.json"
  },
  "files": [
    "components.js",
    "all.js",
    "component/",
    "behaviors/",
    "data/roster.json",
    "README.md",
    "ROBOTS.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "verify": "node scripts/verify.js",
    "verify:fast": "node scripts/verify.js --fast",
    "verify:gates": "node scripts/verify.js --gates",
    "roster:check": "node scripts/roster-check.js",
    "icons:check": "node scripts/icons-check.js"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-native": ">=0.86.0",
    "react-native-web": ">=0.21.0",
    "react-native-svg": ">=15.0.0",
    "helper-utils": "npm:@superloomdev/js-helper-utils@^1.0.0",
    "helper-debug": "npm:@superloomdev/js-helper-debug@^1.0.0",
    "helper-themer": "npm:@superloomdev/js-client-helper-themer@^1.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@superloomdev/js-helper-eslint-config": "^1.0.0",
    "eslint": "^10.2.0"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public"
  }
}
